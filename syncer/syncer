#!/usr/bin/env bash

# Copyright 2026 Google LLC
# syncer - A command-line tool to run KRMSyncer locally.

set -eo pipefail

# Helper formatting functions
info() { echo -e "\033[1;34m[INFO]\033[0m $*"; }
success() { echo -e "\033[1;32m[SUCCESS]\033[0m $*"; }
warn() { echo -e "\033[1;33m[WARNING]\033[0m $*"; }
error() { echo -e "\033[1;31m[ERROR]\033[0m $*"; }

# Check dependencies
check_dep() {
    if ! command -v "$1" &> /dev/null; then
        error "Dependency '$1' is required but not found. Please install it."
        exit 1
    fi
}

check_dep kubectl
check_dep git
check_dep make
check_dep go

# Determine directories
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SYNCER_DIR="$SCRIPT_DIR"

# Initialize variables
SOURCE_CLUSTER=""
DEST_CLUSTER=""
PROJECT=""
SOURCE_LOCATION=""
DEST_LOCATION=""
NAMESPACE="default"

generate_sync_config() {
    cat <<EOF
apiVersion: syncer.gkelabs.io/v1alpha1
kind: KRMSyncer
metadata:
  name: kcc-resource-syncer
  namespace: $NAMESPACE
spec:
  mode: pull
  suspend: false
  remote:
    clusterConfig:
      kubeConfigSecretRef:
        name: source-cluster
  rules:
  - group: pubsub.cnrm.cloud.google.com
    kind: PubSubTopic
    syncFields:
    - spec
    - status
    version: v1beta1
EOF
}

usage() {
    echo "Usage: ./syncer start --source-cluster <name> --source-location <location> --project <id> [options]"
    echo ""
    echo "Commands:"
    echo "  start                             Automates cross cluster secret generation, CRD installation, and local syncer start"
    echo ""
    echo "Options:"
    echo "  --source-cluster <name>           Name of the source cluster"
    echo "  --dest-cluster <name>             Name of the destination cluster"
    echo "  --project <id>                    Google Cloud Project ID"
    echo "  --source-location <name>          GCP location for the source cluster (e.g. us-west1)"
    echo "  --dest-location <name>            GCP location for the destination cluster (e.g. us-central1)"
    echo "  -n, --namespace <name>            Namespace for Syncer CR"
    echo "  -h, --help                        Show this help message"
    exit 1
}

# Ensure at least one argument is provided
if [ "$#" -lt 1 ]; then
    usage
fi

SUBCOMMAND="$1"
shift

if [ "$SUBCOMMAND" != "start" ]; then
    error "Unknown command: $SUBCOMMAND"
    usage
fi

# Parse options
while [[ "$#" -gt 0 ]]; do
    case "$1" in
        -s|--source-cluster)
            SOURCE_CLUSTER="$2"
            shift 2
            ;;
        -d|--dest-cluster)
            DEST_CLUSTER="$2"
            shift 2
            ;;
        -j|--project)
            PROJECT="$2"
            shift 2
            ;;
        --source-location)
            SOURCE_LOCATION="$2"
            shift 2
            ;;
        --dest-location)
            DEST_LOCATION="$2"
            shift 2
            ;;
        -n|--namespace)
            NAMESPACE="$2"
            shift 2
            ;;
        -h|--help)
            usage
            ;;
        *)
            error "Unknown option: $1"
            usage
            ;;
    esac
done

# Validate required inputs
if [ -z "$SOURCE_CLUSTER" ]; then
    error "Missing required option: --source-cluster"
    usage
fi

if [ -z "$SOURCE_LOCATION" ]; then
    error "Missing required option: --source-location"
    usage
fi

if [ -z "$PROJECT" ]; then
    error "Missing required option: --project"
    usage
fi

# Construct GKE contexts if locations are provided
SOURCE_CONTEXT=""
DEST_CONTEXT=""

SOURCE_CONTEXT="gke_${PROJECT}_${SOURCE_LOCATION}_${SOURCE_CLUSTER}"

if [ -n "$DEST_CLUSTER" ] && [ -n "$DEST_LOCATION" ]; then
    DEST_CONTEXT="gke_${PROJECT}_${DEST_LOCATION}_${DEST_CLUSTER}"
fi

# If dest cluster context is empty, fall back to current context
if [ -z "$DEST_CONTEXT" ]; then
    DEST_CONTEXT=$(kubectl config current-context)
    info "No dest-cluster or dest-location is provided. Defaulting to current context: $DEST_CONTEXT"
fi

echo "=================================================="
echo "          KRMSyncer Local Automation Setup        "
echo "=================================================="
info "Source Cluster Context   : $SOURCE_CONTEXT"
info "Dest Cluster Context     : $DEST_CONTEXT"
info "GCP Project ID           : $PROJECT"
info "Namespace                : $NAMESPACE"
echo "=================================================="

# Step 1: Configure Remote Access Secret
echo ""
echo "--- Step 1: Configure Remote Access Secret ---"

KUBECONFIG_FILE="source-cluster-kubeconfig.yaml"
info "Generating kubeconfig for source cluster '$SOURCE_CLUSTER'..."
kubectl config view --context="$SOURCE_CONTEXT" --minify --flatten > "$KUBECONFIG_FILE"
success "Kubeconfig written to $KUBECONFIG_FILE"

info "Verifying source cluster connectivity..."
if kubectl --kubeconfig="$KUBECONFIG_FILE" get nodes &> /dev/null; then
    success "Verified source cluster connection successfully!"
else
    error "Failed to connect to source cluster using generated kubeconfig."
    rm -f "$KUBECONFIG_FILE"
    exit 1
fi

info "Creating destination namespace '$NAMESPACE' on dest cluster if not exists..."
kubectl --context="$DEST_CONTEXT" create namespace "$NAMESPACE" --dry-run=client -o yaml | kubectl --context="$DEST_CONTEXT" apply -f -

info "Creating Kubeconfig Secret 'source-cluster' on dest cluster..."
# Delete existing secret first if there's one to allow clean recreate
kubectl --context="$DEST_CONTEXT" delete secret source-cluster --ignore-not-found

kubectl --context="$DEST_CONTEXT" create secret generic source-cluster \
    --from-file=kubeconfig="$KUBECONFIG_FILE"
success "Secret 'source-cluster' successfully created!"

# Clean up local temporary file
rm -f "$KUBECONFIG_FILE"

# Step 2: Install CRD & Custom Resource Specs
echo ""
echo "--- Step 2: Install CRD and Custom Resource Specs ---"
info "Applying KRMSyncer Custom Resource Definition (CRD)..."
kubectl --context="$DEST_CONTEXT" apply -f "${SYNCER_DIR}/config/crd/syncer.gkelabs.io_krmsyncers.yaml"

info "Deploying KRMSyncer sync configuration..."
generate_sync_config | kubectl --context="$DEST_CONTEXT" apply -f -
success "Sample sync configuration applied successfully!"

# Step 3: Run KRMSyncer locally
echo ""
echo "--- Step 3: Start the Controller Locally ---"
info "Starting KRMSyncer controller locally (press Ctrl+C to stop)..."
cd "$SYNCER_DIR"
go run main.go
